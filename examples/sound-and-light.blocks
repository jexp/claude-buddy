<xml xmlns="https://developers.google.com/blockly/xml">
  <block type="pxt-on-start" x="0" y="0">
    <statement name="HANDLER">
      <block type="claude_buddy_start">
        <next>
          <block type="device_show_icon">
            <field name="i">IconNames.SmallDiamond</field>
          </block>
        </next>
      </block>
    </statement>
  </block>

  <block type="claude_buddy_on_connected" x="220" y="0">
    <statement name="HANDLER">
      <block type="device_show_icon">
        <field name="i">IconNames.Heart</field>
        <next>
          <block type="music_tone_duration">
            <value name="note"><shadow type="music_note_field"><field name="note">523</field></shadow></value>
            <value name="duration"><shadow type="timePicker"><field name="ms">125</field></shadow></value>
            <next>
              <block type="music_tone_duration">
                <value name="note"><shadow type="music_note_field"><field name="note">659</field></shadow></value>
                <value name="duration"><shadow type="timePicker"><field name="ms">125</field></shadow></value>
                <next>
                  <block type="music_tone_duration">
                    <value name="note"><shadow type="music_note_field"><field name="note">784</field></shadow></value>
                    <value name="duration"><shadow type="timePicker"><field name="ms">250</field></shadow></value>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>

  <block type="claude_buddy_on_disconnected" x="440" y="0">
    <statement name="HANDLER">
      <block type="device_show_icon">
        <field name="i">IconNames.SmallDiamond</field>
        <next>
          <block type="music_tone_duration">
            <value name="note"><shadow type="music_note_field"><field name="note">392</field></shadow></value>
            <value name="duration"><shadow type="timePicker"><field name="ms">125</field></shadow></value>
            <next>
              <block type="music_tone_duration">
                <value name="note"><shadow type="music_note_field"><field name="note">330</field></shadow></value>
                <value name="duration"><shadow type="timePicker"><field name="ms">125</field></shadow></value>
                <next>
                  <block type="music_tone_duration">
                    <value name="note"><shadow type="music_note_field"><field name="note">262</field></shadow></value>
                    <value name="duration"><shadow type="timePicker"><field name="ms">250</field></shadow></value>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>

  <block type="claude_buddy_on_permission" x="0" y="240">
    <statement name="HANDLER">
      <block type="music_tone_duration">
        <value name="note"><shadow type="music_note_field"><field name="note">880</field></shadow></value>
        <value name="duration"><shadow type="timePicker"><field name="ms">125</field></shadow></value>
        <next>
          <block type="device_show_string">
            <value name="str"><block type="claude_buddy_pending_tool"/></value>
            <next>
              <block type="device_show_string">
                <value name="str"><block type="claude_buddy_pending_hint"/></value>
                <next>
                  <block type="device_show_leds">
                    <field name="LEDS">`
                      # . # . #
                      . # . # .
                      # . # . #
                      . # . # .
                      # . # . #
                    `</field>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>

  <block type="claude_buddy_on_turn" x="220" y="240">
    <statement name="HANDLER">
      <block type="music_tone_duration">
        <value name="note"><shadow type="music_note_field"><field name="note">659</field></shadow></value>
        <value name="duration"><shadow type="timePicker"><field name="ms">63</field></shadow></value>
        <next>
          <block type="device_show_icon">
            <field name="i">IconNames.Diamond</field>
            <next>
              <block type="device_pause">
                <value name="pause"><shadow type="timePicker"><field name="ms">300</field></shadow></value>
                <next>
                  <block type="device_show_icon">
                    <field name="i">IconNames.Heart</field>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>

  <block type="device_button_event" x="0" y="500">
    <field name="NAME">Button.A</field>
    <statement name="HANDLER">
      <block type="controls_if">
        <value name="IF0"><block type="claude_buddy_has_pending"/></value>
        <statement name="DO0">
          <block type="claude_buddy_approve">
            <next>
              <block type="music_tone_duration">
                <value name="note"><shadow type="music_note_field"><field name="note">1047</field></shadow></value>
                <value name="duration"><shadow type="timePicker"><field name="ms">250</field></shadow></value>
                <next>
                  <block type="device_show_icon">
                    <field name="i">IconNames.Yes</field>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
      </block>
    </statement>
  </block>

  <block type="device_button_event" x="220" y="500">
    <field name="NAME">Button.B</field>
    <statement name="HANDLER">
      <block type="controls_if">
        <value name="IF0"><block type="claude_buddy_has_pending"/></value>
        <statement name="DO0">
          <block type="claude_buddy_deny">
            <next>
              <block type="music_tone_duration">
                <value name="note"><shadow type="music_note_field"><field name="note">131</field></shadow></value>
                <value name="duration"><shadow type="timePicker"><field name="ms">500</field></shadow></value>
                <next>
                  <block type="device_show_icon">
                    <field name="i">IconNames.No</field>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
      </block>
    </statement>
  </block>
</xml>
