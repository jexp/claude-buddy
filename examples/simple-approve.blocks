<xml xmlns="https://developers.google.com/blockly/xml">
  <block type="pxt-on-start" x="0" y="0">
    <statement name="HANDLER">
      <block type="claude_buddy_start">
        <next>
          <block type="device_show_icon">
            <field name="i">IconNames.SmallDiamond</field>
          </block>
        </next>
      </block>
    </statement>
  </block>

  <block type="claude_buddy_on_connected" x="220" y="0">
    <statement name="HANDLER">
      <block type="device_show_icon">
        <field name="i">IconNames.Heart</field>
      </block>
    </statement>
  </block>

  <block type="claude_buddy_on_disconnected" x="440" y="0">
    <statement name="HANDLER">
      <block type="device_show_icon">
        <field name="i">IconNames.SmallDiamond</field>
      </block>
    </statement>
  </block>

  <block type="claude_buddy_on_permission" x="0" y="180">
    <statement name="HANDLER">
      <block type="device_show_string">
        <value name="str">
          <block type="claude_buddy_pending_tool"/>
        </value>
        <next>
          <block type="device_show_leds">
            <field name="LEDS">`
              # . # . #
              . # . # .
              # . # . #
              . # . # .
              # . # . #
            `</field>
          </block>
        </next>
      </block>
    </statement>
  </block>

  <block type="claude_buddy_on_turn" x="220" y="180">
    <statement name="HANDLER">
      <block type="device_show_icon">
        <field name="i">IconNames.Heart</field>
      </block>
    </statement>
  </block>

  <block type="device_button_event" x="0" y="360">
    <field name="NAME">Button.A</field>
    <statement name="HANDLER">
      <block type="logic_compare">
        <field name="OP">EQ</field>
        <value name="A">
          <block type="claude_buddy_has_pending"/>
        </value>
        <value name="B">
          <block type="logic_boolean"><field name="BOOL">TRUE</field></block>
        </value>
      </block>
    </statement>
  </block>

  <block type="device_button_event" x="220" y="360">
    <field name="NAME">Button.B</field>
    <statement name="HANDLER">
      <block type="logic_compare">
        <field name="OP">EQ</field>
        <value name="A">
          <block type="claude_buddy_has_pending"/>
        </value>
        <value name="B">
          <block type="logic_boolean"><field name="BOOL">TRUE</field></block>
        </value>
      </block>
    </statement>
  </block>
</xml>
