        "_locales/fr/claude-buddy-strings.json": "fr",
        "_locales/es/claude-buddy-strings.json": "es",
        "_locales/nl/claude-buddy-strings.json": "nl",
        "_locales/it/claude-buddy-strings.json": "it",
        "_locales/pt/claude-buddy-strings.json": "pt",
        "_locales/ja/claude-buddy-strings.json": "ja",
        "_locales/zh-CN/claude-buddy-strings.json": "zh-CN"
    },
    "public": true,
